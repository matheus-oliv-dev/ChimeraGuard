{
  "$schema": "https://chimera-guard.vercel.app/schema.json",
  "version": "1.6.0",
  "scope": {
    "strictMode": false,
    "allowlist": [],
    "blocklist": [
      "*.gov.br",
      "*.mil.br",
      "*.jus.br"
    ]
  },
  "ai": {
    "enabled": false,
    "provider": "offline",
    "budget": {
      "maxRequestsPerHour": 50,
      "cacheTtlSeconds": 259200
    }
  }
}
