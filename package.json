{
  "name": "chimeraguard",
  "version": "1.6.0",
  "description": "ChimeraGuard - Multi-Vector DevSecOps Platform & Defense Arsenal (formerly ObsidianSec)",
  "type": "module",
  "bin": {
    "chimeraguard": "bin/cli.mjs",
    "chimera": "bin/cli.mjs",
    "obsidiansec": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matheus-oliv-dev/ChimeraGuard.git"
  },
  "scripts": {
    "build": "esbuild src/cli-source.ts --bundle --platform=node --target=node18 --format=esm --outfile=bin/cli.mjs",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "security:audit": "node scripts/run-security-audit.mjs",
    "security:sast": "node scripts/security_squad/sast_sentinel.mjs",
    "security:db": "node scripts/security_squad/db_guardian.mjs",
    "squad:audit": "node --loader ts-node/esm scripts/squad_audit.mjs || node scripts/run-security-audit.mjs",
    "ai:audit": "node scripts/ai_squad_runner.mjs",
    "dashboard": "node scripts/start_dashboard.mjs",
    "start": "node scripts/start_dashboard.mjs"
  },
  "keywords": [
    "chimeraguard",
    "chimera",
    "obsidiansec",
    "security",
    "devsecops",
    "dast",
    "sast",
    "waf",
    "origin-bypass",
    "chaos-engineering",
    "browser-shield",
    "zero-trust"
  ],
  "author": "ChimeraGuard Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@vercel/node": "^5.1.8",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
